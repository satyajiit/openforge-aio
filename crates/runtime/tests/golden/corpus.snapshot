=== SIGNATURE batman-lod/signatures/mod_unlock_all_outfits.toml ===
SignatureSpec {
    meta: Meta {
        feature: "mod_unlock_all_outfits",
        display_name: "Unlock All Outfits",
        tagline: Some(
            "Every Batman, Robin, Nightwing, and Catwoman skin — unlocked.",
        ),
        description: Some(
            "Walks GUObjectArray for every live `DinnerCharacterMetaData` UObject (the per-outfit data assets), filters out NPC/enemy/civilian metas via short-name substring exclude (`_Quest`, `_Goon`, `_Creature`, `Civilian`, `_Henchman`, `_Enemy`, `_Hostile`, `_NPC`, `_Vendor`, `_Bystander`), resolves the `ProgressTag` FProperty on each, reads its FGameplayTag (8 bytes), then calls `TtGameProgressStatics::SetGameProgressValue(world, tag, 2)` once per outfit. Value `2` is the build's 'unlocked' state — the same constant `unlock_all_skills` uses. Tag resolution happens at call time so a new outfit DLC loading mid-session would be picked up on the next toggle press. Caveat: only outfits already loaded in memory are unlocked — for DLC outfits that lazy-load on character-select, open the in-game character menu once before toggling so the assets are paged in. Inspired by a UE4SS Lua mod that uses the same `SetGameProgressState` path.",
        ),
        icon: Some(
            "shirt",
        ),
        icon_color: None,
        tier: "progression",
        kind: "mod",
        discovered_in_version: Some(
            "1.0.0.1",
        ),
        verified_versions: [
            "1.0.0.1",
        ],
        discovered_on: Some(
            "2026-05-25",
        ),
        discovered_by: None,
    },
    value: None,
    write: SetProgressTags {
        source: TagSourceSpec {
            asset_class: "DinnerCharacterMetaData",
            predicate: Any,
            mode: AllUObjectsOfClass {
                tag_property_name: "ProgressTag",
                exclude_name_substrings: [
                    "_Quest",
                    "_Goon",
                    "_Creature",
                    "Civilian",
                    "_Henchman",
                    "_Enemy",
                    "_Hostile",
                    "_NPC",
                    "_Vendor",
                    "_Bystander",
                ],
            },
        },
        call: SetCallSpec {
            statics_class: "TtGameProgressStatics",
            function: "SetGameProgressValue",
            world_context_class: "TtGameProgressLiveData",
            world_context_predicate: Contains(
                "/Engine/Transient/",
            ),
        },
        value: 2,
        display: None,
    },
    locator: None,
    heap_scan: None,
    reflection: None,
    pointer_chain: None,
    control: Some(
        Button {
            label: Some(
                "Unlock all",
            ),
        },
    ),
}

=== SIGNATURE batman-lod/signatures/one_hit_kill.toml ===
SignatureSpec {
    meta: Meta {
        feature: "one_hit_kill",
        display_name: "One-Hit Kill",
        tagline: Some(
            "Goons fold like wet cardboard. Bosses too.",
        ),
        description: Some(
            "Every freeze tick (200 ms), walks GUObjectArray for every live HealthAttributeSet instance, filters out the player + allies (FQN contains `_Playable_`), vehicles (`_VEH_`), the class default (`Default__`), and class templates (`/Engine/Transient/`), and freezes the survivors' Health.CurrentValue at 1.0. Any damage source on a hit drops the target below zero and triggers the engine's death pipeline — works on goons, lieutenants, and bosses uniformly because they all use the same GAS HealthAttributeSet. Bosses with multi-phase health bars cycle through phases on each kill since the freeze keeps re-arming the next phase at 1 HP too. Combine with Infinite Health (Lock Health) for total invulnerability while sweeping the level. Toggle OFF stops the freeze; the game's PreAttributeChange clamps restore newly-spawned enemies to full HP normally.",
        ),
        icon: Some(
            "skull",
        ),
        icon_color: None,
        tier: "combat",
        kind: "trainer",
        discovered_in_version: Some(
            "1.0.0.1",
        ),
        verified_versions: [
            "1.0.0.1",
        ],
        discovered_on: Some(
            "2026-05-25",
        ),
        discovered_by: None,
    },
    value: None,
    write: FreezeForMatching {
        class_path: "HealthAttributeSet",
        class_name_substrings: [],
        field_offsets: [
            68,
        ],
        value: Some(
            1.0,
        ),
        value_bytes: None,
        interval_ms: 200,
        max_results: 1024,
        include_fqn_contains: [],
        exclude_fqn_contains: [
            "_Playable_",
            "_VEH_",
            "Default__",
            "/Engine/Transient/",
            "BP_Population_",
        ],
    },
    locator: None,
    heap_scan: None,
    reflection: None,
    pointer_chain: None,
    control: Some(
        Switch,
    ),
}

