=== SIGNATURE batman-lod/signatures/mod_npc_dance.toml ===
SignatureSpec {
    meta: Meta {
        feature: "mod_npc_dance",
        display_name: "NPC Dance Party",
        tagline: Some(
            "Every NPC near you breaks into LEGO dance moves and goon taunts.",
        ),
        description: Some(
            "Every 2.5s, walks the live UObject list for every NPC class on stage (civilian minifigs, gang goons, GCPD SWAT, Arkham inmates, Two-Face crew), filters to those within 1500u (~15m) of the player's pawn, and fires `Character::PlayAnimMontage` with a random Minifig-skeleton montage cycled across the population so the crowd looks varied. The 14-montage rotation includes dance moves (Pogo, HipHop, Clap), taunts (GoonTaunt 1-4), and gestures (Laugh, GestureHappy, Celebrate). Each NPC's pick rotates with `(tick + npc_index) mod 14` so neighbours never sync. Distance filter is required — beyond ~1500u, civilians are LOD-promoted Mass entities without a live AnimInstance, and PlayAnimMontage on them crashes the game. Toggle OFF stops the loop; the in-flight montages naturally end (~2-4s) and the AnimInstance falls back to the locomotion blendspace. No per-instance restore needed.",
        ),
        icon: Some(
            "music",
        ),
        icon_color: None,
        tier: "world",
        kind: "mod",
        discovered_in_version: Some(
            "1.0.0.1",
        ),
        verified_versions: [
            "1.0.0.1",
        ],
        discovered_on: Some(
            "2026-05-25",
        ),
