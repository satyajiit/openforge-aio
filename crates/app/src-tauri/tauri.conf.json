{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenForge",
  "version": "0.1.0",
  "identifier": "com.gamespatch.openforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "OpenForge",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Utility",
    "shortDescription": "Open-source game trainers for offline games",
    "longDescription": "OpenForge is an open-source AIO trainer for offline single-player games. Community-extensible: drop a folder + open a PR."
  }
}
