{
  "name": "openforge-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "dll:dev": "cargo build -p openforge-batman-lod-dll -p openforge-glacier-007-dll",
    "dll:dev:release": "cargo build --release -p openforge-batman-lod-dll -p openforge-glacier-007-dll",
    "dll:dev:fast": "cargo build --profile dev-fast -p openforge-batman-lod-dll -p openforge-glacier-007-dll",
    "tauri:dev": "cargo build -p openforge-batman-lod-dll -p openforge-glacier-007-dll && tauri dev",
    "tauri:dev:release": "cargo build --release -p openforge-batman-lod-dll -p openforge-glacier-007-dll && tauri dev --release",
    "tauri:dev:fast": "cargo build --profile dev-fast -p openforge-batman-lod-dll -p openforge-glacier-007-dll && tauri dev -- --profile dev-fast",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.5",
    "@radix-ui/react-scroll-area": "^1.2.5",
    "@radix-ui/react-separator": "^1.1.5",
    "@radix-ui/react-slot": "^1.1.5",
    "@radix-ui/react-switch": "^1.1.5",
    "@radix-ui/react-tabs": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@uiw/react-codemirror": "^4.23.0",
    "@babel/runtime": "~7.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
